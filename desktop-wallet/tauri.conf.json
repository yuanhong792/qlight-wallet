{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QLight Wallet",
  "version": "0.1.0",
  "identifier": "net.qlight.wallet",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QLight Wallet · 量子闪电",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
